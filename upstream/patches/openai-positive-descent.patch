+    reserve ≤ scale.rankMargin κ η r ∧
+      scale.rankMargin κ η r ≤ κ := by
+  constructor
+  · exact (by linarith : reserve ≤ κ - (scale.rankCap : ℝ) * η).trans
+      (scale.rankMargin_lower κ η hη r)
+  · exact scale.rankMargin_le κ η hη r
