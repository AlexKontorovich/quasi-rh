import Mathlib.NumberTheory.NumberField.Cyclotomic.PID
import Mathlib.NumberTheory.NumberField.Cyclotomic.Three
import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.RingTheory.UniqueFactorizationDomain.Moebius

/-!
# Eisenstein arithmetic used by the 11/12 argument

This file fixes the number field and its ring of integers.  In particular,
`𝒪` is not an abstract parameter: it is the ring of integers of the third
cyclotomic field, hence a model of the Eisenstein integers.

The analytic core is indexed by ideals, so the public element notation uses
the ideal Mobius function evaluated on the principal ideal `(n)`.  The
predicate `primary` chooses the distinguished associate congruent to `1`
modulo `lambda ^ 2`; the norm is the absolute norm of the same principal
ideal.  This keeps the readable element sum and the ideal-indexed proof on
literally the same arithmetic coefficients.
-/

namespace ElevenTwelfths

/-- The Eisenstein number field `ℚ(ζ₃)`. -/
abbrev K := CyclotomicField 3 ℚ

/-- The Eisenstein integers, realized as the ring of integers of `ℚ(ζ₃)`. -/
abbrev 𝒪 := NumberField.RingOfIntegers K

local instance : IsCyclotomicExtension {3} ℚ K :=
  CyclotomicField.isCyclotomicExtension 3 ℚ

local instance : IsPrincipalIdealRing 𝒪 :=
  IsCyclotomicExtension.Rat.three_pid K

/-- The chosen primitive cube root of unity in the Eisenstein integers. -/
noncomputable def omega : 𝒪 :=
  (IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger

/-- The unique prime above `3`, in the normalization used by Mathlib. -/
noncomputable def lambda : 𝒪 := omega - 1

/-- An Eisenstein integer is primary when it is `1` modulo `lambda ^ 2`. -/
def primary (n : 𝒪) : Prop := lambda ^ 2 ∣ n - 1

/-- The absolute norm of an Eisenstein integer. -/
noncomputable def eisensteinNorm (n : 𝒪) : ℕ :=
  Ideal.absNorm (Ideal.span {n})

/-- The ideal Mobius coefficient of the principal ideal generated by `n`.
Primary restriction removes the remaining choice of associate. -/
noncomputable def eisensteinMobius (n : 𝒪) : ℤ :=
  UniqueFactorizationMonoid.moebius (Ideal.span {n})

/-- Elementwise coprimality in the Eisenstein integers. -/
def eisensteinCoprime (a b : 𝒪) : Prop := IsCoprime a b

@[simp] theorem eisensteinNorm_zero : eisensteinNorm 0 = 0 := by
  simp [eisensteinNorm]

theorem eisensteinNorm_ne_zero {n : 𝒪} (hn : n ≠ 0) : eisensteinNorm n ≠ 0 := by
  intro hnorm
  apply hn
  exact Ideal.span_singleton_eq_bot.mp (Ideal.absNorm_eq_zero_iff.mp hnorm)

@[simp] theorem eisensteinMobius_zero : eisensteinMobius 0 = 0 := by
  rw [eisensteinMobius, show Ideal.span ({0} : Set 𝒪) = 0 by simp]
  exact UniqueFactorizationMonoid.moebius_zero

end ElevenTwelfths
