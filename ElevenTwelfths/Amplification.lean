import ElevenTwelfths.SexticFamily
import Mathlib.Algebra.Order.Chebyshev
import Mathlib.Algebra.Polynomial.Roots

/-!
# Sixth-power amplification

The original Mobius sum is detected on rows of the form `b ^ 6`.  This file
contains the finite, purely algebraic part of that amplification.  It does not
use any analytic information about Eisenstein integers.

Two facts are isolated here:

* a value has at most six sixth roots in an integral domain;
* consequently, Cauchy--Schwarz loses only a factor of six when an average
  over `b` is pushed forward to the sixth-power rows.

The arithmetic statement identifying a sextic character on `b ^ 6` with a
coprimality mask is represented by `M_sixthPower_eq_coprimeM`.  Its local
proof for Eisenstein residue symbols belongs in `Arithmetic.lean`.
-/

namespace ElevenTwelfths

open scoped BigOperators

section Fibers

variable {R : Type*} [CommRing R] [IsDomain R] [DecidableEq R]

/-- A nonzero polynomial of degree six has at most six roots. -/
theorem sixthPowerFiber_card (s : Finset R) (z : R) :
    (s.filter fun b ↦ b ^ 6 = z).card ≤ 6 := by
  classical
  calc
    _ ≤ (Polynomial.nthRoots 6 z).toFinset.card := by
      apply Finset.card_le_card
      intro b hb
      exact Multiset.mem_toFinset.mpr
        ((Polynomial.mem_nthRoots (by norm_num : 0 < 6)).mpr
          (Finset.mem_filter.mp hb).2)
    _ ≤ (Polynomial.nthRoots 6 z).card := Multiset.toFinset_card_le _
    _ ≤ 6 := Polynomial.card_nthRoots 6 z

/-- The set of sixth-power rows generated by a finite set of amplifiers. -/
def sixthPowerRows (s : Finset R) : Finset R := s.image fun b ↦ b ^ 6

omit [IsDomain R] in theorem mem_sixthPowerRows {s : Finset R} {z : R} :
    z ∈ sixthPowerRows s ↔ ∃ b ∈ s, b ^ 6 = z := by
  classical
  simp [sixthPowerRows]

/--
Cauchy--Schwarz after pushing an amplifier average through `b ↦ b ^ 6`.

The factor `6` is the only loss caused by the fact that sixth powers are not
injective: every fiber has cardinality at most six.
-/
theorem sixthPowerAverage_cauchy (s : Finset R) (V A : R → ℂ)
    (hV : ∀ b ∈ s, ‖V b‖ ≤ 1) :
    ‖∑ b ∈ s, V b * A (b ^ 6)‖ ^ 2 ≤
      6 * s.card * ∑ z ∈ sixthPowerRows s, ‖A z‖ ^ 2 := by
  classical
  calc
    ‖∑ b ∈ s, V b * A (b ^ 6)‖ ^ 2
        ≤ (∑ b ∈ s, ‖V b * A (b ^ 6)‖) ^ 2 := by
          gcongr
          exact norm_sum_le _ _
    _ ≤ s.card * ∑ b ∈ s, ‖V b * A (b ^ 6)‖ ^ 2 :=
      sq_sum_le_card_mul_sum_sq
    _ ≤ s.card * ∑ b ∈ s, ‖A (b ^ 6)‖ ^ 2 := by
      gcongr with b hb
      rw [norm_mul]
      calc
        ‖V b‖ * ‖A (b ^ 6)‖ ≤ 1 * ‖A (b ^ 6)‖ :=
          mul_le_mul_of_nonneg_right (hV b hb) (norm_nonneg _)
        _ = ‖A (b ^ 6)‖ := one_mul _
    _ = s.card * ∑ z ∈ sixthPowerRows s,
          ∑ b ∈ s with b ^ 6 = z, ‖A (b ^ 6)‖ ^ 2 := by
      congr 1
      symm
      apply Finset.sum_fiberwise_of_maps_to
      intro b hb
      unfold sixthPowerRows
      exact Finset.mem_image.mpr ⟨b, hb, rfl⟩
    _ = s.card * ∑ z ∈ sixthPowerRows s,
          (s.filter fun b ↦ b ^ 6 = z).card * ‖A z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro z hz
      calc
        _ = ∑ b ∈ s with b ^ 6 = z, ‖A z‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro b hb
          rw [(Finset.mem_filter.mp hb).2]
        _ = (s.filter fun b ↦ b ^ 6 = z).card * ‖A z‖ ^ 2 := by simp
    _ ≤ s.card * ∑ z ∈ sixthPowerRows s, 6 * ‖A z‖ ^ 2 := by
      gcongr with z hz
      exact_mod_cast sixthPowerFiber_card s z
    _ = 6 * s.card * ∑ z ∈ sixthPowerRows s, ‖A z‖ ^ 2 := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum]
      ring

end Fibers

section Mask

variable {R : Type*} [CommRing R]

/-- The untwisted, smoothly localized Mobius sum. -/
noncomputable def untwistedM (norm : R → ℕ) (normBall : ℕ → Finset R)
    (primary : R → Prop) (mobius : R → ℤ) (W : SmoothDyadicWeight ℂ)
    (N : ℕ) : ℂ := by
  classical
  exact ∑ n ∈ normBall N,
    if primary n then (mobius n : ℂ) * W ((norm n : ℝ) / (N : ℝ)) else 0

/-- The untwisted sum with terms not coprime to `b` removed. -/
noncomputable def coprimeM (norm : R → ℕ) (normBall : ℕ → Finset R)
    (primary : R → Prop) (coprime : R → R → Prop) (mobius : R → ℤ)
    (W : SmoothDyadicWeight ℂ) (b : R) (N : ℕ) : ℂ := by
  classical
  exact ∑ n ∈ normBall N,
    if primary n ∧ coprime b n then
      (mobius n : ℂ) * W ((norm n : ℝ) / (N : ℝ))
    else 0

/--
On sixth powers a sextic character is exactly the coprimality mask.  This is
the formal bridge from a twisted row to the original Mobius sum.
-/
theorem M_sixthPower_eq_coprimeM
    (norm : R → ℕ) (normBall : ℕ → Finset R)
    (primary : R → Prop) (coprime : R → R → Prop) (mobius : R → ℤ)
    [DecidablePred primary] [DecidableRel coprime]
    (sexticTwist : R → R → ℂ) (W : SmoothDyadicWeight ℂ) (b : R) (N : ℕ)
    (hsixth : ∀ n, sexticTwist (b ^ 6) n = if coprime b n then 1 else 0) :
    M norm normBall primary mobius sexticTwist W (b ^ 6) N =
      coprimeM norm normBall primary coprime mobius W b N := by
  classical
  unfold M coprimeM
  apply Finset.sum_congr rfl
  intro n hn
  rw [hsixth]
  by_cases hp : primary n <;> by_cases hc : coprime b n <;> simp [hp, hc]

end Mask

end ElevenTwelfths
