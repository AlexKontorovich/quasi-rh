import ElevenTwelfths.EisensteinFamily
import OAI.NumberTheory.DirichletL.Arithmetic.IdealMobius
import OAI.NumberTheory.DirichletL.MeanSquare.OutsideIdeals
import OAI.NumberTheory.DirichletL.GaussSum.ReflectionBrackets

/-!
# The concrete Eisenstein family used by the proof

The readable sum is indexed by the primary generator of each admissible
ideal.  Internally, the OpenAI estimates are stated for ideals.  This file
makes the conversion explicit and proves that the two finite sums agree.

The column ball and row ball are deliberately different, just as they are in
the OpenAI formalization: columns are admissible primary generators, whereas
Poisson summation runs over every Eisenstein integer in a norm ball.
-/

namespace ElevenTwelfths

noncomputable section

open scoped BigOperators Classical

open OAI
open OAI.ActualEisensteinCubic
open OAI.CompletedGauss
open OAI.ConcretePrimeRowBridge hiding O
open OAI.InitialMeanSquare
open OAI.PrimaryIdealUnitReindex
open OAI.ShortDraftHeckeBridge hiding O

/-- The exact finite row ball.  We insert zero because the OpenAI disk omits
it; its summand vanishes under a cutoff supported in `[1/2,1]`. -/
noncomputable def exactRowBall (H : ℕ) : Finset 𝒪 :=
  insert 0 (rowNormDisk H)

theorem mem_exactRowBall {H : ℕ} {u : 𝒪} :
    u ∈ exactRowBall H ↔ 𝒩 u ≤ H := by
  classical
  rw [exactRowBall, Finset.mem_insert]
  constructor
  · rintro (rfl | hu)
    · simp [𝒩]
    · simpa only [𝒩] using (mem_rowNormDisk.mp hu).2
  · intro hu
    by_cases hzero : u = 0
    · exact Or.inl hzero
    · apply Or.inr
      apply mem_rowNormDisk.mpr
      simpa only [𝒩] using
        ⟨Nat.pos_of_ne_zero (𝒩_ne_zero hzero), hu⟩

/-- Admissible columns of norm at most `X`, represented by their canonical
primary Eisenstein generators. -/
noncomputable def outsidePrimaryBall
    (S : Finset (Ideal 𝒪)) (X : ℕ) : Finset 𝒪 :=
  (outsideIdealsUpTo S X).image primaryGenerator

private theorem outside_primaryGenerator_ne_zero
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S) (X : ℕ)
    {I : Ideal 𝒪} (hI : I ∈ outsideIdealsUpTo S X) :
    primaryGenerator I ≠ 0 :=
  primaryGenerator_ne_zero_of_good_factors I
    (outsideIdealsUpTo_ne_bot S X I hI)
    (outside_good S X hbad I hI)

theorem outsidePrimaryBall_primary
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S) (X : ℕ)
    {n : 𝒪} (hn : n ∈ outsidePrimaryBall S X) : primary n := by
  classical
  obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hn
  have hgen := outside_primaryGenerator_ne_zero S hbad X hI
  apply (primary_iff_ramified _).mpr
  simpa [𝔓, ω, ActualEisensteinCubic.lambda,
    ActualEisensteinCubic.omega] using (primaryGenerator_spec I hgen).2

/-- The actual product of local sextic characters attached to the column
generated by `n`. -/
noncomputable def outsideSexticTwist
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S) (X : ℕ)
    (u n : 𝒪) : ℂ :=
  idealSexticRow (outsideIdealsUpTo S X)
    (outsideIdealsUpTo_ne_bot S X) (outside_good S X hbad)
    (Ideal.span {n}) u

/-- The concrete public `M_u(X)`.  Its summand visibly contains primaryness,
ideal Möbius, the sextic twist, and the `[1/2,1]` smooth cutoff. -/
noncomputable def outsideM
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (u : 𝒪) (X : ℕ) : ℂ :=
  ∑ n ∈ outsidePrimaryBall S X,
    if primary n then
      (μ_K n : ℂ) * outsideSexticTwist S hbad X u n *
        W ((𝒩 n : ℝ) / (X : ℝ))
    else 0

theorem outsideM_eq_eisensteinM
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (u : 𝒪) (X : ℕ) :
    outsideM S hbad W u X =
      eisensteinM (outsidePrimaryBall S) (outsideSexticTwist S hbad X) W u X :=
  rfl

/-- The readable primary-element sum is exactly the ideal row consumed by
Poisson summation and the mean-square theorem. -/
theorem outsideM_eq_idealRowSum
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (u : 𝒪) (X : ℕ) :
    outsideM S hbad W u X =
      idealRowSum (outsideIdealsUpTo S X)
        (outsideIdealsUpTo_ne_bot S X) (outside_good S X hbad)
        (1 : DirichletCharacter ℂ 1)
        (fun n ↦ W ((n : ℝ) / (X : ℝ))) u := by
  classical
  unfold outsideM outsidePrimaryBall idealRowSum
  rw [Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro I hI
    have hgen := outside_primaryGenerator_ne_zero S hbad X hI
    have hspan := (primaryGenerator_spec I hgen).1
    have hprimary : primary (primaryGenerator I) := by
      apply (primary_iff_ramified _).mpr
      simpa [𝔓, ω, ActualEisensteinCubic.lambda,
        ActualEisensteinCubic.omega] using (primaryGenerator_spec I hgen).2
    rw [ite_eq_left hprimary]
    simp only [μ_K, 𝒩, outsideSexticTwist, hspan]
    have hchar :
        (1 : DirichletCharacter ℂ 1) (Ideal.absNorm I) = 1 :=
      MulChar.one_apply (isUnit_of_subsingleton _)
    simp only [baseChangeWeight, hchar, mul_one]
    ring
  · intro I hI J hJ hIJ
    have hIgen := outside_primaryGenerator_ne_zero S hbad X hI
    have hJgen := outside_primaryGenerator_ne_zero S hbad X hJ
    rw [← (primaryGenerator_spec I hIgen).1,
      ← (primaryGenerator_spec J hJgen).1, hIJ]

/-- The finite, smoothly weighted mean square attached to `outsideM`. -/
noncomputable def outsideS
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (V : SmoothDyadicCutoff) (X H : ℕ) : ℝ :=
  ∑ u ∈ exactRowBall H,
    V ((𝒩 u : ℝ) / (H : ℝ)) *
      ‖outsideM S hbad W u X‖ ^ 2

/-- Immediately before Poisson summation, the finite row sum becomes a
whole-lattice `tsum`. -/
theorem outsideS_eq_tsum
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (V : SmoothDyadicCutoff) (X H : ℕ) :
    outsideS S hbad W V X H = ∑' u : 𝒪,
      V ((𝒩 u : ℝ) / (H : ℝ)) *
        ‖outsideM S hbad W u X‖ ^ 2 := by
  classical
  unfold outsideS
  rw [tsum_eq_sum (s := exactRowBall H)]
  intro u hu
  have hnorm : H < 𝒩 u :=
    Nat.lt_of_not_ge (fun hle ↦ hu (mem_exactRowBall.mpr hle))
  by_cases hH : H = 0
  · have hV : V 0 = 0 :=
      V.toSmoothDyadicWeight.eq_zero_of_lt_half (by norm_num)
    simp [hH, hV]
  · have hHpos : (0 : ℝ) < H := by exact_mod_cast Nat.pos_of_ne_zero hH
    have hratio : (1 : ℝ) < (𝒩 u : ℝ) / (H : ℝ) := by
      rw [lt_div_iff₀ hHpos]
      simpa only [one_mul] using (show (H : ℝ) < 𝒩 u by exact_mod_cast hnorm)
    rw [V.toSmoothDyadicWeight.eq_zero_of_one_lt hratio, zero_mul]

/-- The same conversion, now with the ideal row exposed in exactly the form
used by the OpenAI Poisson and mean-square modules. -/
theorem outsideS_eq_idealRowSum_tsum
    (S : Finset (Ideal 𝒪))
    (hbad : OAI.CanonicalQuadraticSieve.fixedBadPrimes ⊆ S)
    (W : SmoothDyadicWeight ℂ) (V : SmoothDyadicCutoff) (X H : ℕ) :
    outsideS S hbad W V X H = ∑' u : 𝒪,
      V ((𝒩 u : ℝ) / (H : ℝ)) *
        ‖idealRowSum (outsideIdealsUpTo S X)
          (outsideIdealsUpTo_ne_bot S X) (outside_good S X hbad)
          (1 : DirichletCharacter ℂ 1)
          (fun n ↦ W ((n : ℝ) / (X : ℝ))) u‖ ^ 2 := by
  rw [outsideS_eq_tsum]
  apply tsum_congr
  intro u
  rw [outsideM_eq_idealRowSum]

end

end ElevenTwelfths
